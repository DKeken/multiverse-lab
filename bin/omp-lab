#!/bin/sh
set -eu

WORKSPACE="${MULTIVERSE_LAB_WORKSPACE:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
SSH_HOST="${MULTIVERSE_LAB_SSH_HOST:?Set MULTIVERSE_LAB_SSH_HOST (for example user@inference-host)}"
LOCAL_PORT="${MULTIVERSE_LAB_LOCAL_PORT:-18003}"
REMOTE_PORT="${MULTIVERSE_LAB_REMOTE_PORT:-8003}"

ssh \
  -N \
  -L "127.0.0.1:${LOCAL_PORT}:127.0.0.1:${REMOTE_PORT}" \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  "$SSH_HOST" &
tunnel_pid=$!

cleanup() {
  kill "$tunnel_pid" 2>/dev/null || true
  wait "$tunnel_pid" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

attempt=0
until nc -z 127.0.0.1 "$LOCAL_PORT" 2>/dev/null; do
  if ! kill -0 "$tunnel_pid" 2>/dev/null; then
    wait "$tunnel_pid"
    exit 1
  fi
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 50 ]; then
    printf '%s\n' "SSH tunnel did not become ready on 127.0.0.1:${LOCAL_PORT}" >&2
    exit 1
  fi
  sleep 0.1
done

exec omp \
  --profile "${MULTIVERSE_LAB_OMP_PROFILE:-multiverse-lab}" \
  --cwd "$WORKSPACE" \
  --model "${MULTIVERSE_LAB_MODEL:-cards-llm/agonts-smoll}" \
  --skills 'astropy,qutip,sympy,paper-lookup,hypothesis-generation,scientific-brainstorming' \
  "$@"
