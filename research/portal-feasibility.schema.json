{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted Portal Feasibility IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "epistemic_class", "geometry", "assumptions", "payload", "checks"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "epistemic_class": {"enum": ["NOVEL PROPOSAL", "UNVERIFIED"]},
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "radial_symbol", "throat_radius", "redshift", "shape"],
      "properties": {
        "family": {"const": "morris-thorne-static-spherical"},
        "radial_symbol": {"const": "r"},
        "throat_radius": {"$ref": "#/$defs/expression"},
        "redshift": {"$ref": "#/$defs/expression"},
        "shape": {"$ref": "#/$defs/expression"}
      }
    },
    "symbols": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["domain", "unit"], "properties": {"domain": {"enum": ["real", "positive", "nonnegative"]}, "unit": {"type": "string", "minLength": 1, "maxLength": 32}, "min": {"type": "number"}, "max": {"type": "number"}}}},
    "assumptions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 3, "maxLength": 240}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["radius_m", "length_m", "max_tidal_acceleration_m_s2"], "properties": {"radius_m": {"type": "number", "exclusiveMinimum": 0}, "length_m": {"type": "number", "exclusiveMinimum": 0}, "max_tidal_acceleration_m_s2": {"type": "number", "exclusiveMinimum": 0}}},
    "checks": {"type": "array", "uniqueItems": true, "minItems": 6, "items": {"enum": ["throat", "flare_out", "finite_redshift", "curvature", "nec", "anec", "qei", "tidal", "linear_stability", "backreaction", "chronology", "targeting"]}}
  },
  "$defs": {"expression": {"oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["number"], "properties": {"number": {"type": "number"}}},
    {"type": "object", "additionalProperties": false, "required": ["symbol"], "properties": {"symbol": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}}},
    {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"enum": ["add", "mul"]}, "args": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/expression"}}}},
    {"type": "object", "additionalProperties": false, "required": ["op", "base", "exponent"], "properties": {"op": {"const": "pow"}, "base": {"$ref": "#/$defs/expression"}, "exponent": {"type": "integer", "minimum": -8, "maximum": 8}}},
    {"type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": {"op": {"enum": ["exp", "log", "neg"]}, "arg": {"$ref": "#/$defs/expression"}}}
  ]}}
}
